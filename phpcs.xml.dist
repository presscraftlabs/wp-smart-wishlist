<?xml version="1.0"?>
<ruleset name="WishCraft">
	<description>WordPress Coding Standards for WishCraft.</description>

	<file>install.php</file>
	<file>uninstall.php</file>
	<file>src</file>


	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-smart-wishlist"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_wishcraft"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="WishCraft"/>
				<element value="wishcraft"/>
				<element value="WISHCRAFT"/>
			</property>
		</properties>
	</rule>
</ruleset>
